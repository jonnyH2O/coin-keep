{
  "name": "hero-realms-combat-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run generate:standings",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "generate:standings": "tsx scripts/generate-standings.ts",
    "verify:standings": "tsx scripts/generate-standings.ts --check"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "oxlint": "^1.71.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
